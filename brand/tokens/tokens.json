{
  "$description": "FindMySpare design tokens (brand-evolution v2). Source of truth for web + future mobile.",
  "color": {
    "brand":        { "value": "#E5461B", "use": "logo, icon tile, large brand surfaces, illustrations" },
    "brand-strong": { "value": "#CC3A12", "use": "primary buttons, links, prices-on-white; 4.9:1 with white" },
    "brand-ink":    { "value": "#A32D0C", "use": "pressed states, text on brand-wash" },
    "brand-wash":   { "value": "#FFF1EB", "use": "selected chips, soft brand panels" },
    "ink":          { "value": "#1B1E24", "use": "primary text (16.7:1 on white)" },
    "ink-2":        { "value": "#3E434E", "use": "secondary text" },
    "ink-3":        { "value": "#5B6170", "use": "tertiary text / metadata (6.2:1)" },
    "ink-4":        { "value": "#8A909C", "use": "placeholders and disabled only (not body text)" },
    "paper":        { "value": "#FFFFFF", "use": "canvas, cards" },
    "paper-2":      { "value": "#F6F6F8", "use": "section bands, input fills" },
    "paper-3":      { "value": "#EFEFF3", "use": "app background behind cards" },
    "line":         { "value": "#E9E9EE" },
    "line-2":       { "value": "#D6D7DE" },
    "verified":     { "value": "#0B7A53", "use": "FMS Verified, success, fit confirmed (5.35:1)" },
    "verified-wash":{ "value": "#E7F5EF" },
    "amber":        { "value": "#9A6700", "use": "pending, warranty expiring" },
    "amber-wash":   { "value": "#FFF6E0" },
    "danger":       { "value": "#B42318" },
    "danger-wash":  { "value": "#FDECEA" },
    "info":         { "value": "#2457C5" },
    "info-wash":    { "value": "#EAF0FD" }
  },
  "dark": {
    "paper": "#14161B", "paper-2": "#1B1E24", "paper-3": "#0E0F13", "ink": "#F4F5F7", "ink-2": "#C9CCD3",
    "ink-3": "#9AA0AC", "ink-4": "#6B717D", "line": "#262A32", "line-2": "#343943", "brand-strong": "#FF6A3D",
    "brand-wash": "#2A1710", "verified-wash": "#0F241C", "amber-wash": "#2A220F", "danger-wash": "#2A1513", "info-wash": "#131C30"
  },
  "font": {
    "sans": "Plus Jakarta Sans (OFL), fallback Noto Sans Devanagari for Hindi, system-ui",
    "mono": "JetBrains Mono (OFL), for part numbers, invoice IDs, registration numbers"
  },
  "type": {
    "display": { "size": "40/48 clamp", "weight": 800, "tracking": "-0.03em" },
    "h1": { "size": 28, "weight": 800, "tracking": "-0.02em" },
    "h2": { "size": 22, "weight": 800, "tracking": "-0.015em" },
    "h3": { "size": 17, "weight": 700 },
    "body": { "size": 15, "weight": 500, "line": 1.5 },
    "meta": { "size": 13, "weight": 500 },
    "eyebrow": { "size": 12, "weight": 700, "tracking": "0.04em" }
  },
  "radius": { "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 28, "pill": 999 },
  "shadow": {
    "card": "0 1px 2px rgba(27,30,36,.04), 0 2px 8px rgba(27,30,36,.05)",
    "lifted": "0 8px 24px rgba(27,30,36,.10)",
    "sticky": "0 -4px 16px rgba(27,30,36,.08)"
  },
  "motion": { "ease-out": "cubic-bezier(.16,1,.3,1)", "press": "scale(.97) 120ms", "enter": "translateY(8px)→0 + fade 220ms" },
  "space": { "gutter-mobile": 16, "gutter-desktop": 24, "card-pad": 16, "section": 32 }
}
